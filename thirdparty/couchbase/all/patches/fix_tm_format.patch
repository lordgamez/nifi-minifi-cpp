 #include <optional>
@@ -30,6 +31,14 @@ namespace couchbase
 {
 static constexpr const char* iso_8601_format = "{:%Y-%m-%dT%H:%M:%S%z}";
 
+// fmt 12 cannot format "%z" for std::tm without tm_gmtoff (e.g. on Windows), use strftime like fmt 11
+static auto
+format_iso_8601(const std::tm& value) -> std::string
+{
+  std::array<char, 64> buf{};
+  return { buf.data(), std::strftime(buf.data(), buf.size(), "%Y-%m-%dT%H:%M:%S%z", &value) };
+}
